{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/uhbs/uhbs-standard/raw/main/schemas/genai-benchmark-report.schema.json",
  "title": "UHBS Experimental GenAI/MCP Benchmark Report",
  "description": "Informative GenAI/MCP resilience metrics. Does not change UHQS.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "uhbs_version",
    "status",
    "uhqs_unchanged",
    "mode",
    "metrics"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "uhbs_version": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["experimental", "incomplete"]
    },
    "uhqs_unchanged": { "type": "boolean", "const": true },
    "mode": {
      "type": "string",
      "enum": ["replay", "live"],
      "description": "CI must use replay (deterministic). Live is lab-only."
    },
    "generated_at": { "type": "string" },
    "timing_intent": {
      "type": "string",
      "enum": ["normal", "tarpit", "unspecified"]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clr", "scr"],
      "properties": {
        "clr": {
          "type": "object",
          "additionalProperties": false,
          "required": ["leaks", "attempts", "rate"],
          "properties": {
            "leaks": { "type": "integer", "minimum": 0 },
            "attempts": { "type": "integer", "minimum": 0 },
            "rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
          }
        },
        "scr": {
          "type": "object",
          "additionalProperties": false,
          "required": ["consistent_turns", "total_turns", "rate"],
          "properties": {
            "consistent_turns": { "type": "integer", "minimum": 0 },
            "total_turns": { "type": "integer", "minimum": 0 },
            "rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
          }
        },
        "ttft": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "median_ms": { "type": ["number", "null"], "minimum": 0 },
            "p95_ms": { "type": ["number", "null"], "minimum": 0 },
            "samples": { "type": "integer", "minimum": 0 },
            "penalize_high_latency": {
              "type": "boolean",
              "description": "False when timing_intent is tarpit."
            }
          }
        },
        "injection_hits": { "type": "integer", "minimum": 0 },
        "injection_attempts": { "type": "integer", "minimum": 0 }
      }
    },
    "notes": { "type": "string" }
  }
}
