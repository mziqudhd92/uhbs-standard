{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/uhbs/uhbs-standard/raw/main/schemas/experimental-matrix.schema.json",
  "title": "UHBS Experimental Five-Dimension Matrix Report",
  "description": "Informative multi-dimensional scores. Does not change UHQS, weights, or δ_C.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "uhbs_version",
    "status",
    "uhqs_unchanged",
    "dimensions",
    "composite"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "uhbs_version": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["experimental", "incomplete"]
    },
    "uhqs_unchanged": { "type": "boolean", "const": true },
    "generated_at": { "type": "string" },
    "scorecard_ref": { "type": "string" },
    "notes": { "type": "string" },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fingerprinting_resistance",
        "interaction_depth",
        "artifact_protocol_fidelity",
        "data_quality_actionability",
        "resource_overhead"
      ],
      "properties": {
        "fingerprinting_resistance": { "$ref": "#/$defs/dimension" },
        "interaction_depth": { "$ref": "#/$defs/dimension" },
        "artifact_protocol_fidelity": { "$ref": "#/$defs/dimension" },
        "data_quality_actionability": { "$ref": "#/$defs/dimension" },
        "resource_overhead": { "$ref": "#/$defs/dimension" }
      }
    },
    "composite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "score", "present_count", "missing"],
      "properties": {
        "method": {
          "type": "string",
          "const": "equal_weight_present_only"
        },
        "score": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "present_count": { "type": "integer", "minimum": 0, "maximum": 5 },
        "missing": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "sensitivity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "leave_one_out": {
          "type": "object",
          "additionalProperties": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 100
          }
        },
        "notes": { "type": "string" }
      }
    }
  },
  "$defs": {
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["scored", "missing", "not_applicable"]
        },
        "score": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sample_count": { "type": "integer", "minimum": 0 },
        "source": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  }
}
